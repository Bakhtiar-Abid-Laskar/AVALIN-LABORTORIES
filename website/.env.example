# Google Form server-to-server forward integration (Form: https://forms.gle/sqr9ghGHuaNNK6iS8)
# The contact form API route (/api/contact) forwards all incoming inquiries
# directly into Google Form responses without client iframes.
GOOGLE_FORM_ID=1FAIpQLScBGYlTBTtOCbwJeCz95rRk8Bhw_DKCuyI-CCenv3Uy5X_5dQ
GOOGLE_ENTRY_NAME=entry.1075633969
GOOGLE_ENTRY_EMAIL=entry.1078567489
GOOGLE_ENTRY_PHONE=entry.402683547
GOOGLE_ENTRY_ORG=entry.680423976
GOOGLE_ENTRY_TYPE=entry.24088896
GOOGLE_ENTRY_SUBJECT=entry.87647776
GOOGLE_ENTRY_MESSAGE=entry.1192160198

# Canonical contact routing (defaults are configured in lib/site-config.ts)
CONTACT_EMAIL=avalin.laboratories@gmail.com
PV_EMAIL=avalin.laboratories@gmail.com
